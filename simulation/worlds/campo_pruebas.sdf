<?xml version="1.0" encoding="UTF-8"?>
<!-- Campo de pruebas real. Generado por simulation/tools/campo_pruebas.py -->
<sdf version="1.9">
  <world name="campo_pruebas">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- WMM2025 en el punto de despegue, marco ENU [T] -->
    <magnetic_field>1.9141e-07 2.7903e-05 -3.3208e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.62 0.76 0.9 1</background>
      <shadows>true</shadows>
      <sky></sky>
    </scene>
    <include>
      <uri>model://campo_pruebas</uri>
    </include>
    <!-- Sol desde el sureste, como en la ortofoto (sombras hacia el noroeste) -->
    <light name="sol" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.45 0.3 -0.84</direction>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>36.5117778</latitude_deg>
      <longitude_deg>-4.6959167</longitude_deg>
      <elevation>20.0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
