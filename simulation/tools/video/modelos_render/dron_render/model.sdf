<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='dron_render'>
    <pose>0 0 .17 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <!-- Real drone: 970 g on the scale (battery 200 g) minus 4 x 33 g rotors.
           CoM and inertia from the lumped-mass model in
           simulation/tools/mass_model.py (CAD positions + measured/datasheet masses). -->
      <inertial>
        <pose>-0.0013 0.0023 -0.0087 0 0 0</pose>
        <mass>0.838</mass>
        <inertia>
          <ixx>0.00359</ixx>
          <ixy>-1.9e-06</ixy>
          <ixz>4.6e-05</ixz>
          <iyy>0.00313</iyy>
          <iyz>-4.1e-05</iyz>
          <izz>0.00354</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name="mi_frame_visual">
        <pose>0.123 0.123 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://mi_drone_base/meshes/mi_frame_full.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="estator1">
        <pose>0.1228 0.1228 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://mi_drone_base/meshes/estator.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="estator2">
        <pose>-0.1228 0.1228 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://mi_drone_base/meshes/estator.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="estator3">
        <pose>0.1228 -0.1228 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://mi_drone_base/meshes/estator.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="estator4">
        <pose>-0.1228 -0.1228 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://mi_drone_base/meshes/estator.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Central stack: 125 mm carbon plates, battery plate to Raspberry Pi cage -->
      <collision name="base_link_collision_0">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.13 0.13 0.12</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <!-- Left landing skid (from CAD mesh) -->
      <collision name="base_link_collision_1">
        <pose>0 0.093 -0.148 0 0 0</pose>
        <geometry>
          <box>
            <size>0.16 0.02 0.02</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <!-- Right landing skid (from CAD mesh) -->
      <collision name="base_link_collision_2">
        <pose>0 -0.093 -0.148 0 0 0</pose>
        <geometry>
          <box>
            <size>0.16 0.02 0.02</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>