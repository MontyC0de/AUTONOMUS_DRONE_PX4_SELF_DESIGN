    </joint>
    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.1228 0.1228 0 0 0 0</pose>
      <inertial>
          <mass>0.006</mass>
          <inertia>
            <ixx>4.03e-06</ixx>
